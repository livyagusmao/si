#Faça um programa que converta uma temperatura em Celsius para Fahrenheit.
temp = float (input("Digite a temperatura: "))
op = int(input("1- Transformar p/ Fahrenheit \n2- Tranformar p/ Celsius \n>"))
if op == 1:
   f = temp * 1.8 + 32
   print (f'Temperatura: {f:.1f}°F')
elif op == 2:
    c = (temp - 32) / 1.8
    print (f'Temperatura: {c:.1f}°C')


